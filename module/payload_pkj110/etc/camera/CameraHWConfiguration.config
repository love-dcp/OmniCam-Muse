[OemRequestAvailableCapabilities]
    #3rd app can't access system camera
    SystemCamera =  0;  0;  0;  0;  0;  0;  1;

[AllocateDataPool]
    IsMultithreadAllocateDataPool = TRUE

[SetColorSpaceBT709]
    opertionMode = 0x800B;0x800C;0x80A3;0x80A4;0x80A5;0x80A7;0x8021;0x8028;0x802B;0x802C;0x80BD;0x80AE;0x1;0x800D

[PipelineDestroyNodes]
    disableAsync = TRUE
    exceptPipeline = RealtimeDefault; RealTimeFeatureNZSLSnapshotRDIStatsParse;

[DeferFinalizeBufferDimensions]
    AsyncPipelinelist = MultiCameraRealtime;

